# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paddle Billing (Sandbox)
PADDLE_API_KEY=your_paddle_api_key
PADDLE_WEBHOOK_SECRET_KEY=your_paddle_webhook_secret
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_token
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_50_COINS=your_paddle_price_id_for_50_coins
NEXT_PUBLIC_PADDLE_PRICE_150_COINS=your_paddle_price_id_for_150_coins
NEXT_PUBLIC_PADDLE_PRICE_500_COINS=your_paddle_price_id_for_500_coins
NEXT_PUBLIC_PADDLE_PRICE_SUBSCRIPTION=your_paddle_price_id_for_subscription

# Admin (optional passcode; without it only admin emails can open /admin)
ADMIN_PASSWORD=
ADMIN_EMAIL=

# AI Trend Studio (optional)
FAL_KEY=
ELEVENLABS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
